{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  schedule: [
    'every weekend',
  ],
  labels: [
    'Maintenance',
  ],
  automergeType: 'pr',
  ignoreTests: false,
  minor: {
    automerge: false,
  },
  patch: {
    automerge: true,
  },
  pin: {
    automerge: true,
  },
  packageRules: [
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      automerge: true,
    },
  ],
  vulnerabilityAlerts: {
    labels: [
      '[SECURITY]',
    ],
    schedule: [
      'at any time',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Update tool versions in actions-lint.yml (aqua-managed)',
      managerFilePatterns: [
        '/^\\.github/workflows/actions-lint\\.yml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\n\\s+[A-Z_]+="(?<currentValue>[^"]+)"',
      ],
      versioningTemplate: 'semver',
    },
  ],
}
